{
  "name": "dsh-wechat-mp-search",
  "version": "0.1.0",
  "description": "微信公众号搜狗搜索及文章正文抓取 dsh 插件",
  "keywords": [
    "wechat",
    "weixin",
    "sogou",
    "search",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "cordis",
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "author": "iTraceur",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./mcp-server": {
      "types": "./lib/mcp-server.d.ts",
      "default": "./lib/mcp-server.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-wechat-mp-search": "lib/mcp-server.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iTraceur/dsh-wechat-mp-search.git"
  },
  "bugs": {
    "url": "https://github.com/iTraceur/dsh-wechat-mp-search/issues"
  },
  "homepage": "https://github.com/iTraceur/dsh-wechat-mp-search#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
